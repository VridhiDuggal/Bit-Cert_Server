# Copy to .env and fill in real values. Never commit .env.
# Generate secrets: openssl rand -hex 32

NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173

POSTGRES_USER=bitcert_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bitcert_db
DATABASE_URL=postgresql://bitcert_user:CHANGE_ME@localhost:5432/bitcert_db?schema=public

JWT_SECRET=CHANGE_ME_32_random_bytes_hex
SESSION_SECRET=CHANGE_ME_32_random_bytes_hex
RECIPIENT_JWT_SECRET=CHANGE_ME_32_random_bytes_hex
PRIVATE_KEY_SECRET=CHANGE_ME_32_random_bytes_hex
INVITE_SECRET=CHANGE_ME_32_random_bytes_hex

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="Bit-Cert <CHANGE_ME>"

APP_BASE_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
VERIFICATION_BASE_URL=http://localhost:8000

FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=bit-cert
FABRIC_MSP_ID=appUser
FABRIC_WALLET_PATH=src/wallet
FABRIC_CONNECTION_PROFILE=fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/connection-org1.json
